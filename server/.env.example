# Required on the backend
NODE_ENV=
PORT=
FRONTEND_URL=
MONGODB_URI=
# Use a randomly generated secret of at least 32 characters in production.
JWT_SECRET=
# Use a unique password of at least 16 characters in production.
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional backend settings
MONGODB_URI_STANDARD=
# Optional comma-separated DNS resolvers for mongodb+srv when system DNS fails.
MONGODB_DNS_SERVERS=
CLOUDINARY_FOLDER=
GOOGLE_CLIENT_ID=
SALT_ROUNDS=

# ntfy notification is recommended for production contribution alerts.
NOTIFICATION_PROVIDER=
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
ADMIN_REVIEW_URL=

# Gmail SMTP is optional and should not block uploads.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTRIBUTION_EMAIL=

# Optional server-side AI. Set both key and model for each provider.
AI_ENABLED=true
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
# Per-provider timeout. Failures try the fallback before retrying.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMART_AI_ENABLED=
SMART_AI_MIN_CONFIDENCE=
SMART_AI_INLINE_PDF_MAX_MB=
SMART_AI_TIMEOUT_MS=

# Feature #9 - question extraction
QUESTION_AI_ENABLED=
QUESTION_AI_MIN_CONFIDENCE=
QUESTION_AI_INLINE_PDF_MAX_MB=
QUESTION_AI_TIMEOUT_MS=
QUESTION_PDF_MAX_MB=
QUESTION_DOWNLOAD_TIMEOUT_MS=
# Optional; falls back to GEMINI_MODEL when omitted.
QUESTION_GEMINI_MODEL=
