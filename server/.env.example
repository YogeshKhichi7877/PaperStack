# Required on the backend
NODE_ENV=
PORT=
FRONTEND_URL=
MONGODB_URI=
# Use a randomly generated secret of at least 32 characters in production.
JWT_SECRET=
# Use a unique password of at least 16 characters in production.
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional backend settings
MONGODB_URI_STANDARD=
# Optional comma-separated DNS resolvers for mongodb+srv when system DNS fails.
MONGODB_DNS_SERVERS=
CLOUDINARY_FOLDER=
GOOGLE_CLIENT_ID=
SALT_ROUNDS=

# ntfy notification is recommended for production contribution alerts.
NOTIFICATION_PROVIDER=
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
ADMIN_REVIEW_URL=

# Gmail SMTP is optional and should not block uploads.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTRIBUTION_EMAIL=

# Optional server-side AI. Configure at least one provider key; models have defaults.
AI_ENABLED=true
# Task routes choose a provider by capability. Override only when needed.
# AI_ROUTE_QUESTION_TUTOR=groq,gemini
# AI_ROUTE_QUESTION_EXTRACTION_VISUAL=gemini,groq
# AI_ROUTE_MOCK_GENERATION=groq,gemini
# AI_ROUTE_MOCK_EVALUATION=groq,gemini
# AI_ROUTE_REVISION_CONTENT=groq,gemini
# AI_ROUTE_WAR_ROOM_BRIEFING=groq,gemini
# Per-provider timeout. The next eligible provider runs before retries.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000
GROQ_API_KEY=
# Use a generative chat model. Prompt Guard models classify input and cannot generate answers.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional AI result cache. Memory caching works without Redis; REDIS_URL enables
# a shared cache across server instances. Cache failures never fail a feature.
AI_CACHE_ENABLED=true
AI_CACHE_MEMORY_MAX=500
AI_CACHE_TUTOR_TTL_SECONDS=21600
AI_SEMANTIC_CACHE_THRESHOLD=0.88
AI_CACHE_REVISION_TTL_SECONDS=21600
AI_CACHE_WAR_ROOM_TTL_SECONDS=10800
AI_CACHE_EXTRACTION_TTL_SECONDS=86400
AI_CACHE_METADATA_TTL_SECONDS=86400
REDIS_URL=

# Student AI limits. Authenticated students are keyed by user id, not shared IP.
STUDENT_AI_BURST_WINDOW_MS=60000
STUDENT_AI_BURST_MAX=12
STUDENT_AI_RATE_LIMIT_WINDOW_MS=3600000
STUDENT_AI_RATE_LIMIT_MAX=80

# General API abuse protection (separate from AI quotas).
GENERAL_API_RATE_LIMIT_WINDOW_MS=120000
GENERAL_API_RATE_LIMIT_MAX=300

SMART_AI_ENABLED=
SMART_AI_MIN_CONFIDENCE=
SMART_AI_INLINE_PDF_MAX_MB=
SMART_AI_TIMEOUT_MS=

# Feature #9 - question extraction. This credential is isolated from general AI.
QUESTION_EXTRACTION_AI_ENABLED=true
QUESTION_EXTRACTION_GEMINI_API_KEY=
QUESTION_EXTRACTION_GEMINI_MODEL=gemini-3.5-flash-lite
QUESTION_EXTRACTION_AI_TIMEOUT_MS=60000
QUESTION_EXTRACTION_AI_MAX_RETRIES=2
QUESTION_EXTRACTION_AI_CONCURRENCY=1
# PDF-only admin bulk import: raise cautiously for available server memory.
BULK_UPLOAD_MAX_FILES=30
BULK_UPLOAD_MAX_TOTAL_MB=150
QUESTION_EXTRACTION_RATE_LIMIT_WINDOW_MS=600000
QUESTION_EXTRACTION_RATE_LIMIT_MAX=20
QUESTION_EXTRACTION_AI_INLINE_PDF_MAX_MB=12

# Legacy extraction aliases retained for compatibility; prefer the settings above.
QUESTION_AI_ENABLED=
QUESTION_AI_MIN_CONFIDENCE=
QUESTION_AI_INLINE_PDF_MAX_MB=
QUESTION_AI_TIMEOUT_MS=
QUESTION_PDF_MAX_MB=
QUESTION_DOWNLOAD_TIMEOUT_MS=
