# Required on the backend
NODE_ENV=
PORT=
FRONTEND_URL=
MONGODB_URI=
# Use a randomly generated secret of at least 32 characters in production.
JWT_SECRET=
# Use a unique password of at least 16 characters in production.
ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional backend settings
MONGODB_URI_STANDARD=
# Optional comma-separated DNS resolvers for mongodb+srv when system DNS fails.
MONGODB_DNS_SERVERS=
CLOUDINARY_FOLDER=
GOOGLE_CLIENT_ID=
SALT_ROUNDS=

# ntfy notification is recommended for production contribution alerts.
NOTIFICATION_PROVIDER=
NTFY_SERVER=
NTFY_TOPIC=
NTFY_TOKEN=
ADMIN_REVIEW_URL=

# Gmail SMTP is optional and should not block uploads.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTRIBUTION_EMAIL=

# Optional server-side AI. Configure at least one provider key; models have defaults.
AI_ENABLED=true
# Task routes choose a provider by capability. Override only when needed.
# AI_ROUTE_QUESTION_TUTOR=groq,gemini
# AI_ROUTE_QUESTION_EXTRACTION_VISUAL=gemini,groq
# AI_ROUTE_MOCK_GENERATION=groq,gemini
# Per-provider timeout. The next eligible provider runs before retries.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
GROQ_API_KEY=
# Use a generative chat model. Prompt Guard models classify input and cannot generate answers.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMART_AI_ENABLED=
SMART_AI_MIN_CONFIDENCE=
SMART_AI_INLINE_PDF_MAX_MB=
SMART_AI_TIMEOUT_MS=

# Feature #9 - question extraction
QUESTION_AI_ENABLED=
QUESTION_AI_MIN_CONFIDENCE=
QUESTION_AI_INLINE_PDF_MAX_MB=
QUESTION_AI_TIMEOUT_MS=
QUESTION_PDF_MAX_MB=
QUESTION_DOWNLOAD_TIMEOUT_MS=
