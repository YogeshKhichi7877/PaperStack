PORT=5000
FRONTEND_URL=http://localhost:3000
MONGODB_URI=your_mongodb_uri
JWT_SECRET=your_long_random_secret
ADMIN_PASSWORD=your_admin_password
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
CLOUDINARY_FOLDER=iiit_surat_archive
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
SALT_ROUNDS=12

# ntfy notification is recommended for production contribution alerts.
NOTIFICATION_PROVIDER=ntfy
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
ADMIN_REVIEW_URL=

# Gmail SMTP is optional and should not block uploads.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=
EMAIL_APP_PASSWORD=
CONTRIBUTION_EMAIL=

# Optional non-SRV fallback if your network blocks MongoDB Atlas SRV DNS lookups.
MONGODB_URI_STANDARD=

# Smart Contribution V2 - optional FREE Gemini metadata fallback
# Leave GEMINI_API_KEY empty to use only the local rule engine (still fully functional).
SMART_AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
SMART_AI_MIN_CONFIDENCE=82
SMART_AI_INLINE_PDF_MAX_MB=12
SMART_AI_TIMEOUT_MS=25000
